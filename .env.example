# Meta app > App settings > Basic > App secret. Used to verify X-Hub-Signature-256.
META_APP_SECRET=
# Any random string; paste the same value in Meta's webhook "Verify token" field.
WEBHOOK_VERIFY_TOKEN=
# System-user permanent token with whatsapp_business_messaging permission.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0
# Only these WhatsApp numbers (country code, no +) may create documents. Comma separated.
ALLOWED_SENDERS=917057100034

# Chrome/Chromium binary used for PDF rendering.
# Windows: C:/Program Files/Google/Chrome/Application/chrome.exe   Docker: /usr/bin/chromium
CHROME_PATH=

# Optional: voice notes + free-text input. Any OpenAI-compatible API (Groq default; OpenAI: https://api.openai.com/v1, whisper-1, gpt-4o-mini).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
# Whisper language (ISO-639-1). Empty = auto-detect, which tends to return English for Marathi.
STT_LANGUAGE=mr
LLM_MODEL=openai/gpt-oss-120b

PORT=3000
